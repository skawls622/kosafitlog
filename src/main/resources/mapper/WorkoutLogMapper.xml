<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kosa.fitlog.workout.mapper.WorkoutLogMapper">

    <resultMap id="workoutLogResultMap"
            type="com.kosa.fitlog.workout.dto.WorkoutLogDTO">
        <id property="workoutLogId" column="workout_log_id"/>
        <result property="memberId" column="member_id"/>
        <result property="workoutDate" column="workout_date"/>
        <result property="memo" column="memo"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insertWorkoutLog"
            parameterType="com.kosa.fitlog.workout.dto.WorkoutLogDTO">
        <selectKey keyProperty="workoutLogId" resultType="long" order="BEFORE">
            SELECT SEQ_WORKOUT_LOGS.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO workout_logs (
            workout_log_id, member_id, workout_date, memo
        )
        VALUES (
            #{workoutLogId}, #{memberId}, SYSDATE, #{memo,jdbcType=VARCHAR}
        )
    </insert>

    <select id="findByWorkoutLogIdAndMemberId" resultMap="workoutLogResultMap">
        SELECT workout_log_id, member_id, workout_date, memo, created_at, updated_at
        FROM workout_logs
        WHERE workout_log_id = #{workoutLogId}
          AND member_id = #{memberId}
    </select>
</mapper>
